{
  "name": "rm-live",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_RM_MOCK=1 vite --mode mock",
    "create:im-client": "node --experimental-strip-types src/scripts/createImClient.ts",
    "build": "vue-tsc -b && vite build",
    "build:iframe": "cross-env VITE_BUILD_IFRAME=true vite build --mode iframe",
    "build:all": "pnpm build && pnpm build:iframe",
    "analyze": "vue-tsc -b && vite build --mode analyze",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "pnpm test:run && pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"**/*.{html,vue,css,scss,less}\"",
    "stylelint:fix": "stylelint \"**/*.{html,vue,css,scss,less}\" --fix"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@vueuse/core": "^14.4.0",
    "artplayer": "^5.4.0",
    "artplayer-plugin-chromecast": "^1.1.0",
    "artplayer-plugin-danmuku": "^5.3.0",
    "hls.js": "^1.6.16",
    "leancloud-realtime": "5.0.0-rc.8",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "uuid": "^13.0.2",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue-scoped-css": "^2.12.0",
    "globals": "^17.9.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "stylelint": "~16.16.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-order": "~6.0.4",
    "tailwindcss": "^4.3.3",
    "terser": "^5.49.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-mock-dev-server": "^2.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "prettier --write",
      "pnpm run lint:fix"
    ],
    "*.{html,vue,css,sass,less}": [
      "pnpm run stylelint:fix"
    ]
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
